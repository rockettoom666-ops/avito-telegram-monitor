TELEGRAM_BOT_TOKEN=replace_me
DATABASE_PATH=data/bot.sqlite3
LOG_PATH=logs/bot.log
AVITO_PROFILE_DIR=.runtime/avito-profile
AVITO_HEADLESS=false
AVITO_MAX_ITEMS=100
# Этот прокси используется только Telegram.
PROXY_URL=
# Avito работает напрямую, пока эта строка пустая.
AVITO_PROXY_URL=
MAX_SUBSCRIPTIONS_PER_USER=10
BASIC_PLAN_STARS=150
PRO_PLAN_STARS=250
LIFETIME_PLAN_RUBLES=100
LIFETIME_PLAN_STARS=75
SUPPORT_CONTACT=@your_username
MERCHANT_NAME=Владелец сервиса
# Этот токен выдаёт BotFather после Payments -> Connect ЮKassa.
YOOKASSA_PROVIDER_TOKEN=
# Оставьте true, если в кабинете подключены «Чеки от ЮKassa».
YOOKASSA_SEND_RECEIPT=true
# 1 = без НДС. Для другой налоговой схемы укажите свой код ставки.
YOOKASSA_VAT_CODE=1
# Тестовая сумма RUB: нижний предел 88 задан в этой версии кода.
YOOKASSA_TEST_PRICE_RUBLES=88
# Telegram ID администраторов через запятую. Узнать свой ID: /id в личном чате.
ADMIN_CHAT_IDS=
