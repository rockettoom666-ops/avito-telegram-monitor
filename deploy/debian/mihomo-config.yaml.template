# Этот файл превращается в /etc/mihomo/config.yaml при развёртывании.
# Ссылка подписки подставляется на сервере и не хранится в Git.

mixed-port: 7890
allow-lan: false
bind-address: 127.0.0.1
mode: rule
log-level: info
external-controller: 127.0.0.1:9090
ipv6: true
unified-delay: true
tcp-concurrent: true

profile:
  store-selected: true

proxy-providers:
  vpn-subscription:
    type: http
    url: "__VPN_SUBSCRIPTION_URL__"
    path: ./providers/vpn-subscription.yaml
    interval: 3600
    header:
      User-Agent:
        - "Clash.Meta"
    health-check:
      enable: true
      interval: 600
      url: https://www.gstatic.com/generate_204

proxy-groups:
  - name: VPN
    # Узел выбирается проверочным скриптом по доступности именно Avito, а не
    # только по задержке до нейтрального тестового сайта.
    type: select
    use:
      - vpn-subscription

rules:
  - MATCH,VPN
